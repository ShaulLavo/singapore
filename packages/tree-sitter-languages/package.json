{
  "name": "@singapore-editor/tree-sitter-languages",
  "version": "0.2.17",
  "description": "Tree-sitter grammars and syntax queries for Singapore language plugins.",
  "keywords": [
    "browser",
    "editor",
    "grammars",
    "singapore",
    "tree-sitter",
    "typescript"
  ],
  "homepage": "https://singapore.shaulavo.dev/docs/reference/api/tree-sitter-languages/overview/",
  "bugs": {
    "url": "https://github.com/ShaulLavo/singapore/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/singapore.git"
  },
  "files": [
    "README.md",
    "dist",
    "NOTICE",
    "notices"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.generated.d.ts",
      "import": "./dist/catalog.generated.js",
      "default": "./dist/catalog.generated.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "import": "./dist/css.js",
      "default": "./dist/css.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js",
      "default": "./dist/html.js"
    },
    "./javascript": {
      "types": "./dist/javascript.d.ts",
      "import": "./dist/javascript.js",
      "default": "./dist/javascript.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js",
      "default": "./dist/json.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./tsx": {
      "types": "./dist/tsx.d.ts",
      "import": "./dist/tsx.js",
      "default": "./dist/tsx.js"
    },
    "./typescript": {
      "types": "./dist/typescript.d.ts",
      "import": "./dist/typescript.js",
      "default": "./dist/typescript.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "languages:generate": "node scripts/generate.mjs",
    "languages:verify": "node scripts/generate.mjs --check && bun run build && vitest run",
    "languages:build": "node scripts/build-grammars.mjs",
    "languages:build:sql": "node scripts/build-sql.mjs",
    "languages:build:mdx": "node scripts/build-mdx.mjs"
  },
  "dependencies": {
    "@singapore-editor/tree-sitter": "workspace:*",
    "@tree-sitter-grammars/tree-sitter-lua": "0.4.1",
    "@tree-sitter-grammars/tree-sitter-toml": "0.7.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "0.7.1",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-css": "0.25.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-html": "0.23.2",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-jsdoc": "0.25.0",
    "tree-sitter-json": "0.24.8",
    "tree-sitter-md": "github:ShaulLavo/tree-sitter-md#f02e277a34375f326572b4ade2602f44ac769005",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-regex": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-svelte": "0.11.0",
    "tree-sitter-typescript": "0.23.2"
  },
  "devDependencies": {
    "@singapore-editor/core": "workspace:*",
    "@types/node": "^26.6.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "web-tree-sitter": "github:ShaulLavo/tree-sitter-x#33a55c7dabb47ea24b56fe63fc70c7555665fd65"
  },
  "peerDependencies": {
    "@singapore-editor/core": "workspace:*",
    "@singapore-editor/tree-sitter": "workspace:*"
  },
  "engines": {
    "bun": ">=1.2.22",
    "node": ">=26.0.0"
  }
}
