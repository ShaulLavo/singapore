{
  "name": "@singapore-editor/example-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run --browser.enabled --browser.headless",
    "test:e2e": "playwright test",
    "test:iphone": "bun native-iphone/native.ts",
    "test:iphone:webkit": "bun native-iphone/local.ts",
    "typecheck:iphone": "tsc --noEmit -p native-iphone/tsconfig.json",
    "typecheck": "tsc --noEmit && bun run typecheck:iphone",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@singapore-editor/collab": "workspace:*",
    "@singapore-editor/collaboration": "workspace:*",
    "@singapore-editor/core": "workspace:*",
    "@singapore-editor/diff": "workspace:*",
    "@singapore-editor/find": "workspace:*",
    "@singapore-editor/gutters": "workspace:*",
    "@singapore-editor/minimap": "workspace:*",
    "@singapore-editor/plugin-ui": "workspace:*",
    "@singapore-editor/scope-lines": "workspace:*",
    "@singapore-editor/spellcheck": "workspace:*",
    "@singapore-editor/textbuffer": "workspace:*",
    "@singapore-editor/tree-sitter": "workspace:*",
    "@singapore-editor/tree-sitter-languages": "workspace:*",
    "@singapore-editor/typescript-lsp": "workspace:*",
    "@tanstack/query-core": "^5.104.0",
    "evlog": "^2.29.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "catalog:",
    "@vitest/browser-playwright": "5.0.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "waffle": "https://github.com/ShaulLavo/waffle/releases/download/waffle-v0.0.129/waffle-0.0.129.tgz"
  }
}
